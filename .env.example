# Copy to .env.local for local development. On Vercel, set these in the
# project's environment variables instead. Never commit real values.
#
# Every variable is optional: the app starts and the affordability search,
# map and suburb pages work with none of them set.

# OpenRouteService key. Used for driving times (/api/commute) and for route
# lines on the map (/api/directions, driving and cycling).
# Optional. Missing: /api/directions answers 503, and /api/commute falls back
# to Google Routes if GOOGLE_MAPS_API_KEY is set, otherwise to a straight-line
# estimate flagged is_estimate: true.
OPENROUTE_API_KEY=

# Transport for NSW Open Data key (Trip Planner API). Used for public
# transport times in /api/commute.
# Optional. Missing: transit is null with transit_error "not_configured".
TFNSW_API_KEY=

# Google Maps Platform key with the Routes API enabled. Fallback for driving
# times in /api/commute when OpenRouteService is not configured or fails.
# Optional. Missing: no fallback; driving uses the straight-line estimate
# whenever OpenRouteService cannot answer.
GOOGLE_MAPS_API_KEY=

# Switch for the AI chat endpoint (POST /api/chat). Only the exact value
# "true" turns it on.
# Optional. Missing or any other value: /api/chat answers 503 "Chat is disabled".
CHAT_ENABLED=

# Anthropic API key, read only by POST /api/chat.
# Needed only when CHAT_ENABLED=true. Missing while chat is enabled:
# /api/chat answers 503.
ANTHROPIC_API_KEY=
